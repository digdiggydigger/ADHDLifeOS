# macOS
.DS_Store

# Local secrets
.env

# Claude Code
.claude/

# Xcode
xcuserdata/
*.xcscmblueprint
*.xccheckout
DerivedData/
*.xcresult/

# Swift Package Manager
.swiftpm/
.build/

# AWS Lambda build artifacts (reproducible from source)
aws-backend/**/build/
aws-backend/**/__pycache__/
aws-backend/**/*.zip

# ElevenLabs voice agent project (local-only agent configs, may include API refs)
.agents/elevenlabs_voice/

# Local agent tooling (not app code)
.agents/
skills-lock.json

# Firebase Functions
functions/node_modules/
functions/.env
.firebase/

# Signed Shortcut build artifact — not reproducible byte-for-byte (signing embeds a
# certificate chain), and regenerable from the committed XML beside it.
shortcuts/*.shortcut

# Firebase Emulator Suite artifacts — written into the repo root by `firebase emulators:start`
firebase-debug.log
firestore-debug.log
ui-debug.log
storage-debug.log
database-debug.log
pubsub-debug.log
.firebase/
